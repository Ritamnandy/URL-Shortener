<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Sign in to manage your shortened links.">
    <title>Sign in | Shorten</title>
    <style nonce="<%= typeof cspNonce === 'undefined' ? '' : cspNonce %>">
        :root {
            color-scheme: light;
            --page: #f5f7fb;
            --surface: #ffffff;
            --text: #172033;
            --muted: #667085;
            --line: #d9e0ec;
            --primary: #4659e8;
            --primary-dark: #3547ce;
            --ring: rgba(70, 89, 232, .18);
        }

        * { box-sizing: border-box; }

        body {
            min-width: 320px;
            min-height: 100vh;
            margin: 0;
            display: grid;
            place-items: center;
            padding: 24px;
            color: var(--text);
            background:
                radial-gradient(circle at 4% 4%, #dfe4ff 0, transparent 26rem),
                radial-gradient(circle at 96% 98%, #d6f2ef 0, transparent 24rem),
                var(--page);
            font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        }

        .auth-card {
            width: min(100%, 440px);
            padding: 42px;
            background: var(--surface);
            border: 1px solid rgba(217, 224, 236, .8);
            border-radius: 20px;
            box-shadow: 0 20px 60px rgba(30, 41, 59, .10);
        }

        .brand {
            display: inline-flex;
            align-items: center;
            gap: 9px;
            color: var(--text);
            font-size: 1.05rem;
            font-weight: 800;
            letter-spacing: -.02em;
            text-decoration: none;
        }

        .brand-mark {
            width: 30px;
            height: 30px;
            display: grid;
            place-items: center;
            border-radius: 9px;
            color: #fff;
            background: var(--primary);
            font-size: .9rem;
        }

        h1 {
            margin: 32px 0 8px;
            font-size: clamp(1.7rem, 4vw, 2rem);
            letter-spacing: -.04em;
        }

        .intro {
            margin: 0 0 30px;
            color: var(--muted);
            line-height: 1.55;
        }

        form { display: grid; gap: 19px; }

        .field { display: grid; gap: 8px; }

        label {
            font-size: .9rem;
            font-weight: 650;
        }

        input {
            width: 100%;
            min-height: 48px;
            padding: 12px 13px;
            border: 1px solid var(--line);
            border-radius: 10px;
            outline: none;
            color: var(--text);
            background: #fff;
            font: inherit;
            transition: border-color .15s ease, box-shadow .15s ease;
        }

        input::placeholder { color: #98a2b3; }

        input:focus {
            border-color: var(--primary);
            box-shadow: 0 0 0 4px var(--ring);
        }

        .field-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 12px;
        }

        .link {
            color: var(--primary);
            font-size: .88rem;
            font-weight: 650;
            text-decoration: none;
        }

        .link:hover { text-decoration: underline; }

        button {
            min-height: 49px;
            margin-top: 4px;
            cursor: pointer;
            border: 0;
            border-radius: 10px;
            color: #fff;
            background: var(--primary);
            font: inherit;
            font-weight: 700;
            transition: background .15s ease, transform .15s ease;
        }

        button:hover { background: var(--primary-dark); }
        button:active { transform: translateY(1px); }

        .footer {
            margin: 27px 0 0;
            color: var(--muted);
            text-align: center;
            font-size: .92rem;
        }

        .footer .link { margin-left: 4px; font-size: inherit; }

        @media (max-width: 480px) {
            body { padding: 14px; }
            .auth-card { padding: 30px 24px; border-radius: 16px; }
        }
    </style>
</head>
<body>
    <main class="auth-card">
        <a class="brand" href="/" aria-label="Shorten home">
            <span class="brand-mark" aria-hidden="true">↗</span>
            Shorten
        </a>

        <h1>Welcome back</h1>
        <p class="intro">Sign in to create, organise, and track your short links.</p>

        <form action="/api/v1/auth/login" method="post">
            <div class="field">
                <label for="email">Email address</label>
                <input id="email" name="email" type="email" autocomplete="email" placeholder="you@example.com" maxlength="100" required>
            </div>

            <div class="field">
                <div class="field-row">
                    <label for="password">Password</label>
                    <a class="link" href="/forgot-password">Forgot password?</a>
                </div>
                <input id="password" name="password" type="password" autocomplete="current-password" placeholder="Enter your password" maxlength="50" required>
            </div>

            <button type="submit">Sign in</button>
        </form>

        <p class="footer">New to Shorten?<a class="link" href="/register">Create an account</a></p>
    </main>
</body>
</html>
